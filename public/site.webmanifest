{
  "id": "/",
  "name": "Phosphor",
  "short_name": "Phosphor",
  "description": "Turn images into ANSI or ASCII art in your browser, then paint, type, animate, and export.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#1a1a1a",
  "background_color": "#1a1a1a",
  "icons": [
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "launch_type": "multiple-clients",
      "accept": {
        "application/x-phosphor": [".phosphor"],
        "text/x-ansi": [".ans", ".asc", ".nfo", ".diz"],
        "text/x-utf8ans": [".utf8ans"],
        "application/x-xbin": [".xb"],
        "text/plain": [".txt"],
        "image/svg+xml": [".svg"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/bmp": [".bmp"],
        "image/avif": [".avif"]
      }
    }
  ]
}
